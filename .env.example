# Copy this file to .env and replace every value with a local-only value.
# Generate passwords, for example: openssl rand -base64 32
DOKENE_DB_NAME=
DOKENE_DB_BOOTSTRAP_USERNAME=
DOKENE_DB_BOOTSTRAP_PASSWORD=
# Used by a backend run from the host (./gradlew bootRun). Containers always use postgres:5432 on the compose network.
DOKENE_DB_URL=
# Host port that publishes PostgreSQL (loopback only). Change it if another PostgreSQL already uses 5432,
# and use the same port in DOKENE_DB_URL.
# DOKENE_DB_HOST_PORT=5432
DOKENE_DB_USERNAME=dokene_runtime
DOKENE_DB_PASSWORD=
DOKENE_DB_MIGRATION_USERNAME=dokene_migration
DOKENE_DB_MIGRATION_PASSWORD=
# Milliseconds a request waits for a pooled connection before answering 503 (default 3000; keep it at 500 or more).
DOKENE_DB_CONNECTION_TIMEOUT_MS=3000
# Retry-After on that 503 while the database is unreachable (default 5s).
DOKENE_DB_UNAVAILABLE_RETRY_AFTER=5s
# Seconds one blocking database read may take before the connection is treated as lost (default 30). Keep it above
# the longest legitimate statement, including lock waits.
DOKENE_DB_SOCKET_TIMEOUT_SECONDS=30
# Generate with: openssl rand -hex 32. Cryptographic key for signed tenant context verification.
DOKENE_TENANT_CONTEXT_SIGNING_KEY=
# Key ID identifying the active signing key (default: default)
DOKENE_TENANT_CONTEXT_KEY_ID=default
# Must equal DOKENE_DB_RUNTIME_PASSWORD for local Compose.
DOKENE_DB_RUNTIME_PASSWORD=

# Keycloak local admin credentials and port (loopback-only)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
KEYCLOAK_PORT=8081

# OIDC browser login. Keep the client secret only in local environment/secret storage.
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_DOKENE_PROVIDER=dokene
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_DOKENE_CLIENT_ID=dokene-bff
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_DOKENE_CLIENT_SECRET=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_DOKENE_SCOPE=openid,profile
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_DOKENE_REDIRECT_URI={baseUrl}/login/oauth2/code/{registrationId}
# Keycloak discovery endpoint. Automatically tracks KEYCLOAK_PORT when sourced in shell environments.
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_DOKENE_ISSUER_URI=http://localhost:${KEYCLOAK_PORT:-8081}/realms/dokene
# Forwarded headers strategy (none | framework | native). Keep none unless behind a trusted edge proxy.
# When running behind a reverse proxy/load balancer with TLS offloading, set to framework.
# Invariant: the edge proxy must strip and overwrite inbound Forwarded and X-Forwarded-* headers from untrusted clients.
SERVER_FORWARD_HEADERS_STRATEGY=none

# Use false only for local HTTP. Production must keep secure cookies enabled.
DOKENE_SESSION_COOKIE_SECURE=false
DOKENE_SESSION_TIMEOUT=30m
# Comma-separated exact origins. Leave empty for same-origin browser traffic only.
DOKENE_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Post-login redirect URL. Defaults to / for same-origin production deployments.
# When developing locally with Vite on port 5173, set to http://localhost:5173/.
DOKENE_POST_LOGIN_REDIRECT_URL=http://localhost:5173/
# Post-login failure redirect URL. Defaults to {post-login-redirect-url}?error=login_failed.
DOKENE_POST_LOGIN_FAILURE_REDIRECT_URL=http://localhost:5173/?error=login_failed

# Enable workspace self-provisioning (required for local QA seed script: scripts/seed-local-qa.sh)
DOKENE_PROVISIONING_ENABLED=true

# AI Provider configuration ('fake' for offline testing, 'openai' for live model calls, empty to disable AI).
# Any other value fails application startup.
DOKENE_AI_PROVIDER=fake
# OpenAI API key (never commit real credentials)
DOKENE_AI_OPENAI_API_KEY=
# Model identifier (default: gpt-6-luna)
DOKENE_AI_OPENAI_MODEL=gpt-6-luna
# Optional custom base URL for OpenAI-compatible endpoints or proxies
DOKENE_AI_OPENAI_BASE_URL=
# Outbound call timeout
DOKENE_AI_OPENAI_TIMEOUT=15s
# SDK-level retries must stay 0; retries are owned by DOKENE_AI_RETRY_* (see below)
DOKENE_AI_OPENAI_MAX_RETRIES=0

# Bounded retry for transient AI provider failures (timeout, throttling, provider unavailable).
# Total deadline is always the request timeout. max-attempts: 1 disables retry, hard maximum 3.
DOKENE_AI_RETRY_MAX_ATTEMPTS=2
# Backoff values must not exceed 30s; on throttling the provider's Retry-After is honored.
DOKENE_AI_RETRY_INITIAL_BACKOFF=250ms
DOKENE_AI_RETRY_MAX_BACKOFF=2s
DOKENE_AI_RETRY_MIN_ATTEMPT_BUDGET=1s

# Integration secret source (spec 0006). Blank keeps the resolver disabled: every secret lookup fails closed.
# `local` reads operator-supplied entries from the indexed variables below (indices contiguous from 0; validated
# at startup; never for production). Values are used exactly as written, so a stray space or newline is part of
# the secret. Placeholders only in this file. The indexed variables reach a host-run backend only
# (set -a; . ./.env; set +a; ./gradlew bootRun); the Compose backend forwards just the SOURCE variable, so
# give it the entries through a compose override file or a mounted application.yml (see the wiki).
DOKENE_INTEGRATION_SECRETS_SOURCE=
# DOKENE_INTEGRATION_SECRETS_LOCAL_ENTRIES_0_SCOPE=tenant
# DOKENE_INTEGRATION_SECRETS_LOCAL_ENTRIES_0_TENANT_ID=00000000-0000-0000-0000-000000000000
# DOKENE_INTEGRATION_SECRETS_LOCAL_ENTRIES_0_REF=whatsapp-token
# DOKENE_INTEGRATION_SECRETS_LOCAL_ENTRIES_0_PURPOSE=WHATSAPP_ACCESS_TOKEN
# DOKENE_INTEGRATION_SECRETS_LOCAL_ENTRIES_0_VALUE=replace-me
# DOKENE_INTEGRATION_SECRETS_LOCAL_ENTRIES_1_SCOPE=deployment
# DOKENE_INTEGRATION_SECRETS_LOCAL_ENTRIES_1_REF=webhook-verify-token
# DOKENE_INTEGRATION_SECRETS_LOCAL_ENTRIES_1_PURPOSE=WEBHOOK_VERIFY_TOKEN
# DOKENE_INTEGRATION_SECRETS_LOCAL_ENTRIES_1_VALUE=replace-me
# DOKENE_INTEGRATION_SECRETS_LOCAL_ENTRIES_2_SCOPE=deployment
# DOKENE_INTEGRATION_SECRETS_LOCAL_ENTRIES_2_REF=app-secret
# DOKENE_INTEGRATION_SECRETS_LOCAL_ENTRIES_2_PURPOSE=APP_SECRET
# DOKENE_INTEGRATION_SECRETS_LOCAL_ENTRIES_2_VALUE=replace-me

# Meta webhook verification (spec 0007). Each value is the bare key (ref) of a deployment entry above, never the
# secret itself: APP_SECRET_REF names the APP_SECRET entry, VERIFY_TOKEN_REF the WEBHOOK_VERIFY_TOKEN entry.
# Blank keeps that path refusing every request. A malformed or whitespace padded ref fails startup.
DOKENE_INTEGRATION_WHATSAPP_VERIFY_TOKEN_REF=
DOKENE_INTEGRATION_WHATSAPP_APP_SECRET_REF=
# Largest webhook body accepted, in bytes (1 to 16777216; default 4 MiB, Meta documents payloads up to 3 MB).
# DOKENE_INTEGRATION_WHATSAPP_WEBHOOK_MAX_BODY_BYTES=4194304

# Global outbound kill switch (spec 0008). Off by default: no environment can message a customer until an operator
# sets it to true and restarts the backend. No API, tenant setting or header can turn it on.
DOKENE_MESSAGING_OUTBOUND_ENABLED=false

# Opt-in live AI evaluation (./gradlew aiEvalLive, Issue 98). Spends provider tokens; synthetic data only.
# Never needed for CI or normal development. Leave unset unless you intend to run a live evaluation.
# DOKENE_AI_EVAL_LIVE=true
# DOKENE_AI_EVAL_PROMPT_POLICY=
# DOKENE_AI_EVAL_REPORT_NAME=live
# DOKENE_AI_EVAL_MIN_SUCCESS_RATIO=0.5
# DOKENE_AI_EVAL_PRICE_INPUT_PER_MTOK=
# DOKENE_AI_EVAL_PRICE_OUTPUT_PER_MTOK=
