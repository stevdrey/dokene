@@ -3,4 +3,12 @@ package io.github.stevdrey.dokene.purchase.application;
 import io.github.stevdrey.dokene.purchase.domain.Purchase;
 import java.util.List;
 
-public record PurchasePage(List<Purchase> purchases, String nextCursor) { }
+public record PurchasePage(List<Purchase> purchases, String nextCursor) {
+    /** Builds a page from a fetch of up to {@code limit + 1} rows; the extra row only signals a next page. */
+    static PurchasePage of(List<Purchase> fetched, int limit) {
+        if (fetched.size() <= limit) return new PurchasePage(fetched, null);
+        Purchase boundary = fetched.getLast();
+        return new PurchasePage(fetched.subList(0, limit),
+                new PurchaseCursor(boundary.purchasedAt(), boundary.id().value()).encode());
+    }
+}
