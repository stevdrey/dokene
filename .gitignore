# OS / IDE
.DS_Store
.idea/
*.iml
.vscode/
# Only the shared Codex hook definition is versioned; local Codex files stay ignored.
.codex/*
!.codex/hooks.json

# Java / Gradle
.gradle/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# Node
**/node_modules/
**/dist/
**/.vite/
*.tsbuildinfo


# Environment and secrets
.env
.env.*
!.env.example
# File-mounted Compose secrets written from .env by scripts/dev-env.sh (issue 308).
.secrets/
*.pem
*.key

# Logs
*.log

# Local data
.data/

# Local tooling, never committed
.pnpm-store/
compose.override.yaml
frontend/pnpm-lock.yaml
