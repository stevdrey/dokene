# Supply chain attack prevention configuration
# 1. Block arbitrary lifecycle script execution (preinstall, postinstall, install)
ignore-scripts=true

# 2. Enforce exact version pinning to prevent unexpected SemVer drift
save-exact=true

# 3. Enforce deterministic lockfile creation and updates
package-lock=true

# 4. Enforce security audits on package operations
audit=true
audit-level=high

# 5. Restrict registry to official npm registry to prevent dependency confusion
registry=https://registry.npmjs.org/

# 6. Reduce output noise
fund=false
