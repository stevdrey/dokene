{
  "id": "dokene",
  "realm": "dokene",
  "displayName": "Dokene",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "ssoSessionMaxLifespan": 28800,
  "clients": [
    {
      "clientId": "dokene-bff",
      "name": "Dokene BFF",
      "description": "Spring Boot Backend / BFF confidential client for Dokene",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${env.DOKENE_OIDC_CLIENT_SECRET}",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:8080/login/oauth2/code/dokene",
        "http://127.0.0.1:8080/login/oauth2/code/dokene"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://127.0.0.1:8080"
      ],
      "attributes": {
        "oidc.ciba.grant.enabled": "false",
        "pkce.code.challenge.method": "S256",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.url": "http://oidc-bridge:8080/logout/connect/back-channel/dokene",
        "backchannel.logout.revoke.offline.tokens": "false",
        "post.logout.redirect.uris": "http://localhost:8080/##http://127.0.0.1:8080/##http://localhost:5173/##http://127.0.0.1:5173/"
      },
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "users": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "username": "testuser",
      "email": "testuser@dokene.local",
      "firstName": "Test",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${env.DOKENE_TEST_OWNER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "id": "00000000-0000-0000-0000-000000000002",
      "username": "testoperator",
      "email": "testoperator@dokene.local",
      "firstName": "Test",
      "lastName": "Operator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${env.DOKENE_TEST_OPERATOR_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "id": "00000000-0000-0000-0000-000000000003",
      "username": "testviewer",
      "email": "testviewer@dokene.local",
      "firstName": "Test",
      "lastName": "Viewer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${env.DOKENE_TEST_VIEWER_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
